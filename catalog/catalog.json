            "name_contains",
            "limit"
          ],
          "additionalProperties": false,
          "properties": {
            "uid": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "name_contains": {
              "type": "string",
              "maxLength": 64
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            }
          }
        },
